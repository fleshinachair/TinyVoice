{
    "id": "tinyvoice",
    "name": "TinyVoice",
    "abbrev": "TVO",
    "version": "1.0.1",
    "description": "Four engines for the voice: a 13-mode vocoder and voice transformer (Robot, Snap, Chords, Prism, Tape, Nightcall, Scream, Dalek, HardTune, Harmony, Walkie, Morph, Double), Synth Voice (a one-page talking formant filter with presets) Resynth (hard tuning and harmonic resynthesis with a wavetable synth; imports Humanoid presets) and Mangler (a multi-voice pitch and formant shifter: unison, spread, chords from the pads, a filter)",
    "author": "Mat Taylor",
    "dsp": "tinyvoice.so",
    "api_version": 2,
    "component_type": "audio_fx",
    "capabilities": {
        "chainable": true,
        "component_type": "audio_fx",
        "audio_in": true,
        "midi_in": true,
        "ui_hierarchy": {
            "modes": ["vocoder", "synth voice", "resynth", "mangler"],
            "mode_param": "engine",
            "levels": {
                "vocoder": {
                    "name": "TinyVoice",
                    "knobs": ["mode", "char1", "char2", "mod", "char4", "char5", "mix", "gain"],
                    "params": [
                        {"level": "VOICE", "label": "Voice"},
                        {"level": "PITCH", "label": "Pitch"},
                        {"level": "MORE", "label": "More"},
                        {"level": "LOOPER", "label": "Looper"}
                    ]
                },
                "VOICE": {
                    "label": "Voice",
                    "knobs": ["mode", "char1", "char2", "mod", "char4", "char5", "mix", "gain"],
                    "params": ["mode", "char1", "char2", "mod", "char4", "char5", "mix", "gain"]
                },
                "PITCH": {
                    "label": "Pitch",
                    "knobs": ["key", "scale", "retune", "glide", "pitch", "target", "cents"],
                    "params": ["key", "scale", "retune", "glide", "pitch", "target", "cents"]
                },
                "MORE": {
                    "label": "More",
                    "knobs": ["spread", "tone", "gate", "latch", "beauty", "demo"],
                    "params": ["spread", "tone", "gate", "latch", "beauty", "demo"]
                },
                "LOOPER": {
                    "label": "Looper",
                    "knobs": ["freeze_rec", "freeze", "freeze_len"],
                    "params": ["freeze_rec", "freeze", "freeze_len"]
                },
                "synth voice": {
                    "name": "Synth Voice",
                    "list_param": "vf_preset",
                    "count_param": "vf_preset_count",
                    "name_param": "vf_preset_name",
                    "knobs": ["vf_vowel", "vf_tract", "vf_peak", "vf_choir", "vf_breath", "vf_attack", "vf_release", "vf_mix"],
                    "params": ["vf_vowel", "vf_tract", "vf_peak", "vf_choir", "vf_breath", "vf_attack", "vf_release", "vf_mix", {"level": "audition", "label": "Audition"}]
                },
                "audition": {
                    "label": "Audition",
                    "knobs": ["demo"],
                    "params": ["demo"]
                },
                "resynth": {
                    "name": "Resynth",
                    "list_param": "rs_preset",
                    "count_param": "rs_preset_count",
                    "name_param": "rs_preset_name",
                    "knobs": ["hm_transform", "hm_robotify", "hm_formant_shift", "hm_synth_mix", "hm_pitch_shift", "hm_octaving", "hm_quantize", "hm_dry_wet"],
                    "params": ["hm_transform", "hm_robotify", "hm_formant_shift", "hm_synth_mix", "hm_pitch_shift", "hm_octaving", "hm_quantize", "hm_dry_wet", "rs_presets_page", {"level": "rs_pitch", "label": "Pitch"}, {"level": "rs_synth", "label": "Synth"}, {"level": "rs_tone", "label": "Tone"}, {"level": "rs_play", "label": "Play"}, {"level": "rs_notes", "label": "Notes"}, {"level": "rs_looper", "label": "Looper"}, {"level": "rs_bank", "label": "Bank"}]
                },
                "rs_pitch": {
                    "label": "Pitch",
                    "knobs": ["hm_tuning_mode", "hm_key", "hm_scale", "hm_scale_hold", "hm_tuner_attack", "hm_min_f0", "hm_max_f0", "hm_smoothing"],
                    "params": ["hm_tuning_mode", "hm_key", "hm_scale", "hm_scale_hold", "hm_tuner_attack", "hm_min_f0", "hm_max_f0", "hm_smoothing"]
                },
                "rs_synth": {
                    "label": "Synth",
                    "knobs": ["hm_transform", "hm_wave", "hm_wavetable_shape", "hm_wavetable_stretch", "hm_warble_depth", "hm_warble_rate", "hm_warble_mode", "hm_widen"],
                    "params": ["hm_transform", "hm_wave", "hm_wavetable_shape", "hm_wavetable_stretch", "hm_warble_depth", "hm_warble_rate", "hm_warble_mode", "hm_widen"]
                },
                "rs_tone": {
                    "label": "Tone",
                    "knobs": ["hm_hpf_freq", "hm_lpf_freq", "hm_filter_freq", "hm_filter_gain", "hm_noisegate_threshold", "hm_deess", "hm_sharpen", "hm_output_gain"],
                    "params": ["hm_hpf_freq", "hm_lpf_freq", "hm_filter_freq", "hm_filter_gain", "hm_noisegate_threshold", "hm_deess", "hm_sharpen", "hm_output_gain"]
                },
                "rs_play": {
                    "label": "Play",
                    "knobs": ["hm_freeze", "hm_lookahead", "hm_freeze_sync", "hm_freeze_synclength", "hm_input_gain", "hm_mic_gate", "demo"],
                    "params": ["hm_freeze", "hm_lookahead", "hm_freeze_sync", "hm_freeze_synclength", "hm_input_gain", "hm_mic_gate", "demo"]
                },
                "rs_notes": {
                    "label": "Notes",
                    "knobs": ["hm_tuning_duophonic", "hm_pitch_mono", "hm_pitch_duo", "latch", "hm_midi_idle"],
                    "params": ["hm_tuning_duophonic", "hm_pitch_mono", "hm_pitch_duo", "latch", "hm_midi_idle"]
                },
                "rs_looper": {
                    "label": "Looper",
                    "knobs": ["freeze_rec", "freeze", "freeze_len"],
                    "params": ["freeze_rec", "freeze", "freeze_len"]
                },
                "rs_bank": {
                    "label": "Bank",
                    "knobs": ["rs_bank"],
                    "params": ["rs_bank"]
                },
                "mangler": {
                    "name": "Mangler",
                    "list_param": "rs_preset",
                    "count_param": "rs_preset_count",
                    "name_param": "rs_preset_name",
                    "knobs": ["mg_shift", "mg_pitch", "mg_formant", "mg_voices", "mg_detune", "mg_time", "mg_grain", "mg_mix"],
                    "params": ["mg_shift", "mg_pitch", "mg_formant", "mg_voices", "mg_detune", "mg_time", "mg_grain", "mg_mix", "rs_presets_page", {"level": "mg_more", "label": "More"}, {"level": "mg_filter", "label": "Filter"}, {"level": "mg_looper", "label": "Looper"}, {"level": "mg_bank", "label": "Bank"}]
                },
                "mg_more": {
                    "label": "More",
                    "knobs": ["mg_notes", "mg_chord", "mg_mono", "mg_fix", "mg_snap", "mg_scatter", "mg_smear", "mg_wide"],
                    "params": ["mg_notes", "mg_chord", "mg_mono", "mg_fix", "mg_snap", "mg_scatter", "mg_smear", "mg_wide"]
                },
                "mg_filter": {
                    "label": "Filter",
                    "knobs": ["mg_filter", "mg_freq", "mg_width", "mg_gjitter", "mg_volume", "hm_mic_gate", "latch", "demo"],
                    "params": ["mg_filter", "mg_freq", "mg_width", "mg_gjitter", "mg_volume", "hm_mic_gate", "latch", "demo"]
                },
                "mg_looper": {
                    "label": "Looper",
                    "knobs": ["freeze_rec", "freeze", "freeze_len"],
                    "params": ["freeze_rec", "freeze", "freeze_len"]
                },
                "mg_bank": {
                    "label": "Bank",
                    "knobs": ["rs_bank"],
                    "params": ["rs_bank"]
                }
            }
        },
        "chain_params": [
            {"key": "mode", "name": "Mode", "type": "enum", "options": ["Robot", "Snap", "Chords", "Prism", "Tape", "Nightcall", "Scream", "Dalek", "HardTune", "Harmony", "Walkie", "Morph", "Double"], "default": 1},
            {"key": "key", "name": "Key", "type": "enum", "options": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"], "default": 0, "viz": {"kind": "custom:tinyvoice_key", "group": "key", "role": "a", "extra_keys": ["mode"]}},
            {"key": "scale", "name": "Scale", "type": "enum", "options": ["Chromatic", "Major", "Minor", "Pentatonic", "Dorian"], "default": 0, "viz": {"kind": "custom:tinyvoice_scale", "group": "scale", "role": "a", "extra_keys": ["mode"]}},
            {"key": "retune", "name": "Retune", "type": "float", "min": 0, "max": 500, "step": 1, "unit": "ms", "default": 0, "viz": {"kind": "custom:tinyvoice_retune", "group": "retune", "role": "a", "extra_keys": ["mode"]}},
            {"key": "char1", "name": "Char 1", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "char2", "name": "Char 2", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "gate", "name": "Gate", "type": "enum", "options": ["Auto", "-60 dB", "-57 dB", "-54 dB", "-51 dB", "-48 dB", "-45 dB", "-42 dB", "-39 dB", "-36 dB", "-33 dB", "-30 dB", "-27 dB", "-24 dB", "-21 dB", "-18 dB", "-15 dB", "-12 dB", "-9 dB", "-6 dB", "-3 dB", "0 dB"], "default": 0},
            {"key": "mix", "name": "Mix", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 1},
            {"key": "gain", "name": "Level", "type": "float", "min": -12, "max": 12, "step": 0.5, "unit": "dB", "default": 0},
            {"key": "spread", "name": "Spread", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.25},
            {"key": "tone", "name": "Tone", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 1},
            {"key": "glide", "name": "Glide", "type": "float", "min": 0, "max": 500, "step": 1, "unit": "ms", "default": 0, "viz": {"kind": "custom:tinyvoice_glide", "group": "glide", "role": "a", "extra_keys": ["mode"]}},
            {"key": "mod", "name": "Mod", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0},
            {"key": "freeze_len", "name": "Length", "type": "enum", "options": ["Free", "1 Bar", "2 Bars", "4 Bars"], "default": 2, "viz": {"kind": "custom:tinyvoice_freeze", "group": "freeze", "role": "c", "extra_keys": ["scope"]}},
            {"key": "beauty", "name": "Beauty", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5, "viz": {"kind": "custom:tinyvoice_beauty", "group": "beauty", "role": "a", "extra_keys": ["mode"]}},
            {"key": "latch", "name": "Latch", "type": "enum", "options": ["Off", "On"], "default": 0, "viz": {"kind": "custom:tinyvoice_latch", "group": "latch", "role": "a", "extra_keys": ["mode", "engine", "hm_tuning_mode", "mg_notes"]}},
            {"key": "char4", "name": "Char 4", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "char5", "name": "Char 5", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "engine", "name": "Engine", "type": "enum", "options": ["Vocoder", "Synth Voice", "Resynth", "Mangler"], "default": 0},
            {"key": "vf_vowel", "name": "Vowel", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.0},
            {"key": "vf_tract", "name": "Tract", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "vf_peak", "name": "Peak", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.5},
            {"key": "vf_choir", "name": "Choir", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.35},
            {"key": "vf_breath", "name": "Breath", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.15},
            {"key": "vf_attack", "name": "Attack", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.12},
            {"key": "vf_release", "name": "Release", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.3},
            {"key": "vf_mix", "name": "Mix/Drv", "type": "float", "min": 0, "max": 1, "step": 0.01, "unit": "%", "default": 0.75},
            {"key": "vf_preset", "name": "Preset", "type": "float", "min": 0, "max": 5, "step": 1, "default": 5},
            {"key": "rs_bank", "name": "Bank", "type": "enum", "options": ["Default", "Imported", "Tuner", "Voco", "Harmony", "Synth", "Dryish", "Instrument", "Artists", "Mine"], "default": 0},
            {"key": "rs_preset", "name": "Preset", "type": "float", "min": 0, "max": 1023, "step": 1, "default": 0},
            {"key": "hm_pitch_mono", "name": "Note", "type": "float", "min": 24, "max": 96, "step": 1, "default": 60, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_pitch_mono", "role": "a", "extra_keys": ["hm_tuning_mode"]}},
            {"key": "hm_pitch_duo", "name": "Duo Note", "type": "float", "min": 24, "max": 96, "step": 1, "default": 67, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_pitch_duo", "role": "a", "extra_keys": ["hm_tuning_mode", "hm_tuning_duophonic"]}},
            {"key": "hm_quantize_enabled", "name": "Bypass", "type": "enum", "options": ["Off", "On"], "default": 0},
            {"key": "hm_tuner_attack", "name": "Q Attack", "type": "float", "min": 0, "max": 0.4, "step": 0.01, "unit": "s", "default": 0.2},
            {"key": "hm_pitch_shift", "name": "Shift", "type": "float", "min": -12, "max": 12, "step": 1, "unit": "st", "default": 0, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_pitch_shift", "role": "a", "extra_keys": ["hm_synth_mix"]}},
            {"key": "hm_noisegate_threshold", "name": "Gate", "type": "float", "min": -80, "max": -6, "step": 1, "unit": "dB", "default": -80},
            {"key": "hm_noisegate_attack", "name": "G Attack", "type": "float", "min": 0.001, "max": 0.2, "step": 0.001, "unit": "s", "default": 0.05},
            {"key": "hm_noisegate_hold", "name": "G Hold", "type": "float", "min": 0.001, "max": 0.4, "step": 0.001, "unit": "s", "default": 0.05},
            {"key": "hm_noisegate_release", "name": "G Release", "type": "float", "min": 0.001, "max": 0.4, "step": 0.001, "unit": "s", "default": 0.01},
            {"key": "hm_quantize", "name": "Quantize", "type": "float", "min": 0.03, "max": 0.5, "step": 0.01, "default": 0.25},
            {"key": "hm_tuner_polarity", "name": "Polarity", "type": "enum", "options": ["Off", "On"], "default": 0},
            {"key": "hm_tuner_hold", "name": "Q Hold", "type": "float", "min": 0, "max": 100, "step": 1, "default": 0},
            {"key": "hm_transform", "name": "Transform", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_transform", "role": "a", "extra_keys": ["hm_synth_mix"]}},
            {"key": "hm_wavetable_stretch", "name": "Stretch", "type": "float", "min": 0.1, "max": 0.9, "step": 0.01, "default": 0.5, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_wavetable_stretch", "role": "a", "extra_keys": ["hm_synth_mix", "hm_transform"]}},
            {"key": "hm_wavetable_shape", "name": "Shape", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_wavetable_shape", "role": "a", "extra_keys": ["hm_synth_mix", "hm_transform"]}},
            {"key": "hm_chebyshev_0", "name": "Odd 1", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": 1},
            {"key": "hm_chebyshev_1", "name": "Even 1", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": -0.5},
            {"key": "hm_chebyshev_2", "name": "Odd 2", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": -0.3},
            {"key": "hm_chebyshev_3", "name": "Even 2", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": 0.4},
            {"key": "hm_chebyshev_4", "name": "Odd 3", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": 0.6},
            {"key": "hm_chebyshev_5", "name": "Even 3", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": -0.8},
            {"key": "hm_chebyshev_6", "name": "Odd 4", "type": "float", "min": -2, "max": 2, "step": 0.01, "default": -0.4},
            {"key": "hm_lpf_freq", "name": "LPF", "type": "float", "min": 57, "max": 138, "step": 0.5, "default": 138},
            {"key": "hm_lpf_res", "name": "LPF Res", "type": "float", "min": -80, "max": 24, "step": 0.5, "unit": "dB", "default": 0},
            {"key": "hm_hpf_freq", "name": "HPF", "type": "float", "min": 10, "max": 107, "step": 0.5, "default": 10},
            {"key": "hm_hpf_res", "name": "HPF Res", "type": "float", "min": -80, "max": 24, "step": 0.5, "unit": "dB", "default": 0},
            {"key": "hm_filter_freq", "name": "Mid Freq", "type": "float", "min": 28, "max": 127, "step": 0.5, "default": 98.29, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_filter_freq", "role": "a", "extra_keys": ["hm_filter_gain"]}},
            {"key": "hm_filter_gain", "name": "Mid Gain", "type": "float", "min": -60, "max": 24, "step": 0.5, "unit": "dB", "default": 0},
            {"key": "hm_filter_width", "name": "Mid Width", "type": "float", "min": 8, "max": 60, "step": 1, "default": 34},
            {"key": "hm_lookahead", "name": "Latency", "type": "enum", "options": ["Lo", "Mid", "Hi"], "default": 0},
            {"key": "hm_min_f0", "name": "Range Lo", "type": "float", "min": 40, "max": 60, "step": 1, "default": 48},
            {"key": "hm_max_f0", "name": "Range Hi", "type": "float", "min": 69, "max": 84, "step": 1, "default": 79},
            {"key": "hm_input_gain", "name": "In Gain", "type": "float", "min": -16, "max": 16, "step": 0.1, "unit": "dB", "default": 0},
            {"key": "hm_synth_mix", "name": "Synth Mix", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_formant_shift", "name": "Formant", "type": "float", "min": -1, "max": 1, "step": 0.01, "default": 0},
            {"key": "hm_formant_width", "name": "Fmt Width", "type": "float", "min": 0, "max": 0.5, "step": 0.005, "default": 0.125},
            {"key": "hm_robotify", "name": "Robotify", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
            {"key": "hm_robotify_res", "name": "Denoise", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_robotify_harm", "name": "Metallic", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_robotify_flatten", "name": "Flatten", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_robotify_emphasis", "name": "Emphasis", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.1},
            {"key": "hm_octaving", "name": "Octave", "type": "float", "min": -1, "max": 1.5, "step": 0.01, "default": 0, "viz": {"kind": "custom:tinyvoice_rsna", "group": "hm_octaving", "role": "a", "extra_keys": ["hm_synth_mix"]}},
            {"key": "hm_smoothing", "name": "Smoothing", "type": "float", "min": 0.1, "max": 0.9, "step": 0.01, "default": 0.1},
            {"key": "hm_smoothing_pitch", "name": "Sm Pitch", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_smoothing_timbre", "name": "Sm Timbre", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_deess", "name": "De-ess", "type": "float", "min": 0, "max": 24, "step": 0.1, "unit": "dB", "default": 0},
            {"key": "hm_deess_sensitivity", "name": "DS Sens", "type": "float", "min": 0.1, "max": 0.6, "step": 0.01, "default": 0.4},
            {"key": "hm_deess_attack", "name": "DS Attack", "type": "float", "min": 0.005, "max": 0.05, "step": 0.001, "unit": "s", "default": 0.02},
            {"key": "hm_sharpen", "name": "Sharpen", "type": "float", "min": 0, "max": 100, "step": 1, "default": 80},
            {"key": "hm_sharpen_bias", "name": "Bias", "type": "float", "min": -6, "max": 6, "step": 0.1, "default": 0},
            {"key": "hm_dry_wet", "name": "Dry/Wet", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 1},
            {"key": "hm_widen", "name": "Widen", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0},
            {"key": "hm_widen_cutoff", "name": "Wd Cutoff", "type": "float", "min": 0.8, "max": 1, "step": 0.005, "default": 0.9},
            {"key": "hm_widen_rate", "name": "Wd Rate", "type": "float", "min": 0.3, "max": 10, "step": 0.1, "default": 7},
            {"key": "hm_freeze", "name": "Glitch", "type": "enum", "options": ["Off", "On"], "default": 0},
            {"key": "hm_freeze_length", "name": "Glitch ms", "type": "float", "min": 1, "max": 1000, "step": 1, "unit": "ms", "default": 101},
